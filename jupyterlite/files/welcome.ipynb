   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Welcome to QuranKit Interactive! 🕌\n",
    "\n",
    "This is a **live Jupyter environment** running in your browser via WebAssembly (Pyodide).\n",
    "\n",
    "**No installation required** — QuranKit is pre-loaded and ready to use!\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test import\n",
    "from qurankit import Quran\n",
    "\n",
    "# Load Quran (uses bundled sample data)\n",
    "quran = Quran.load()\n",
    "print(f\"✅ QuranKit loaded successfully!\")\n",
    "print(f\"Edition: {quran.edition_id}\")\n",
    "print(f\"Available editions: {[e.id for e in quran.available_editions]}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Basic Text Access\n",
    "\n",
    "Get surahs, ayahs, and navigate the Qur'anic structure."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Get Surah Al-Fatiha (1)\n",
    "surah = quran.surah(1)\n",
    "print(f\"Surah 1: {surah.name_arabic} ({surah.name_english})\")\n",
    "print(f\"Ayahs: {surah.ayah_count}\")\n",
    "print(f\"Revelation: {surah.revelation_type}\")\n",
    "\n",
    "# Get Ayah 1:1 (Bismillah)\n",
    "ayah = quran.ayah_text(1, 1)\n",
    "print(f\"\\n1:1 → {ayah.text_original}\")\n",
    "\n",
    "# Iterate through Surah Al-Fatiha\n",
    "print(\"\\nSurah Al-Fatiha:\")\n",
    "for ayah in quran.surah(1).ayahs:\n",
    "    print(f\"  {ayah.reference}: {ayah.text_original[:60]}\")\n",
    "\n",
    "# List all surahs\n",
    "print(\"\\nAll Surahs:\")\n",
    "for s in quran.surahs:\n",
    "    print(f\"  {s.number}: {s.name_arabic} ({s.name_english}) - {s.ayah_count} ayahs\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Search with Arabic Normalization\n",
    "\n",
    "QuranKit provides 4 normalization profiles for Arabic text search."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from qurankit.search import SearchMode\n",
    "\n",
    "query = \"بسم الله الرحمن الرحيم\"\n",
    "\n",
    "for mode in [SearchMode.EXACT_SOURCE, SearchMode.CANONICAL_UNICODE, \n",
    "             SearchMode.DIACRITICS_INSENSITIVE, SearchMode.SEARCH_BROAD]:\n",
    "    results = quran.search(query, mode=mode)\n",
    "    print(f\"{mode.value}: {len(results)} results\")\n",
    "    for r in results[:2]:\n",
    "        print(f\"  {r['reference']}: {r['matched_text'][:50]}\")\n",
    "    print()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Search Examples - More Queries\n",
    "\n",
    "Try different search patterns."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Search for 'رحمن' (merciful)\n",
    "results = quran.search(\"رحمن\", mode=SearchMode.SEARCH_BROAD)\n",
    "print(f\"'رحمن' (broad): {len(results)} results\")\n",
    "for r in results[:5]:\n",
    "    print(f\"  {r['reference']}: {r['matched_text']}\")\n",
    "\n",
    "# Search for 'قل' (say - command form)\n",
    "results = quran.search(\"قل\", mode=SearchMode.SEARCH_BROAD)\n",
    "print(f\"\\n'قل' (broad): {len(results)} results\")\n",
    "for r in results[:5]:\n",
    "    print(f\"  {r['reference']}: {r['matched_text']}\")\n",
    "\n",
    "# Search for 'إياك' (you alone)\n",
    "results = quran.search(\"إياك\", mode=SearchMode.DIACRITICS_INSENSITIVE)\n",
    "print(f\"\\n'إياك' (diacritic-insensitive): {len(results)} results\")\n",
    "for r in results:\n",
    "    print(f\"  {r['reference']}: {r['matched_text']}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Mutashabihat Analysis (Repeated Phrases)\n",
    "\n",
    "Find exact and near-duplicate phrases across the Qur'an."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from qurankit.analysis import MutashabihatEngine\n",
    "\n",
    "engine = MutashabihatEngine()\n",
    "\n",
    "# Exact phrase matches for Ayat al-Kursi (2:255)\n",
    "result = engine.find_exact_phrase(\"2:255\", min_length=2)\n",
    "print(f\"Exact phrase matches for 2:255: {len(result.matches)}\")\n",
    "for match in result.matches[:3]:\n",
    "    print(f\"  {match.reference}: {match.matched_text}\")\n",
    "\n",
    "# Normalized matches (ignores diacritics)\n",
    "result = engine.find_normalized_matches(\n",
    "    \"2:255\",\n",
    "    normalization_profile=\"diacritics-insensitive-v1\",\n",
    "    min_words=2\n",
    ")\n",
    "print(f\"\\nNormalized matches for 2:255: {len(result.matches)}\")\n",
    "for match in result.matches[:3]:\n",
    "    print(f\"  {match.reference}: {match.matched_text} [{match.match_type.value}]\")\n",
    "\n",
    "# Recurring n-grams (3-grams appearing 2+ times)\n",
    "ngrams = engine.find_exact_ngrams(n=3, min_occurrences=2)\n",
    "print(f\"\\nRecurring 3-grams: {len(ngrams)}\")\n",
    "for ng in ngrams[:10]:\n",
    "    print(f\"  {ng.text} — {ng.count} occurrences\")\n",
    "\n",
    "# Find similar openings\n",
    "result = engine.find_similar_openings(\"1:1\", min_words=2)\n",
    print(f\"\\nSimilar openings to 1:1: {len(result.matches)}\")\n",
    "for match in result.matches[:5]:\n",
    "    print(f\"  {match.reference}: {match.matched_text}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Vocabulary & Root Analysis\n",
    "\n",
    "**Note**: Full vocabulary features require the QAC morphology dataset.\n",
    "The interactive demo uses minimal sample data."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "vocab = quran.vocabulary\n",
    "print(f\"Vocabulary available: {vocab is not None}\")\n",
    "\n",
    "if vocab:\n",
    "    # Try root frequency (may be limited in demo)\n",
    "    try:\n",
    "        roots = vocab.get_root_frequency_list(min_occurrences=5, limit=10)\n",
    "        print(\"\\nTop roots by frequency:\")\n",
    "        for r in roots:\n",
    "            print(f\"  {r['root_form']}: {r['frequency']} (surahs: {r['surah_count']})\")\n",
    "    except Exception as e:\n",
    "        print(f\"Root analysis limited in demo: {e}\")\n",
    "    \n",
    "    # Try concordance\n",
    "    try:\n",
    "        concordance = vocab.get_concordance(root_form=\"ر ح م\", context_words=3, limit=5)\n",
    "        print(\"\\nConcordance for ر ح م:\")\n",
    "        for line in concordance:\n",
    "            print(f\"  {line['reference']}: ...{line['target_form']}...\")\n",
    "    except Exception as e:\n",
    "        print(f\"Concordance limited in demo: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Extension Adapters - Tafsir\n",
    "\n",
    "Access tafsir (exegesis) data from classical sources."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check available adapters\n",
    "print(\"Extension adapters:\")\n",
    "print(f\"  Tafsir: {quran.tafsir is not None}\")\n",
    "print(f\"  Hadith: {quran.hadith is not None}\")\n",
    "print(f\"  Qira'at: {quran.qiraat is not None}\")\n",
    "print(f\"  Tajwid: {quran.tajwid is not None}\")\n",
    "print(f\"  Waqf: {quran.waqf is not None}\")\n",
    "\n",
    "# Example: Tafsir for Surah Al-Fatiha (1:1-1:7)\n",
    "try:\n",
    "    entries = quran.tafsir.get_tafsir_range(1, 1, 1, 7)\n",
    "    print(f\"\\nTafsir for Surah 1 (all ayahs): {len(entries)} entries\")\n",
    "    for entry in entries[:5]:\n",
    "        print(f\"  [{entry.source_id}] {entry.surah_number}:{entry.ayah_start}-{entry.ayah_end} - {entry.text_original[:100]}...\")\n",
    "except Exception as e:\n",
    "    print(f\"\\nTafsir: {e}\")\n",
    "\n",
    "# Search tafsir by topic\n",
    "try:\n",
    "    results = quran.tafsir.search(\"رحمة\", limit=5)\n",
    "    print(f\"\\nTafsir search for 'رحمة': {len(results)} results\")\n",
    "    for r in results:\n",
    "        print(f\"  [{r.source_id}] {r.surah_number}:{r.ayah_start} - {r.text_original[:80]}...\")\n",
    "except Exception as e:\n",
    "    print(f\"Tafsir search: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Extension Adapters - Hadith\n",
    "\n",
    "Access hadith collections (Sahih Bukhari, Muslim, etc.)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Get hadith by topic\n",
    "try:\n",
    "    hadiths = quran.hadith.get_by_topic(\"wahy\", limit=3)\n",
    "    print(f\"Hadith about 'wahy' (revelation): {len(hadiths)} results\")\n",
    "    for h in hadiths:\n",
    "        print(f\"  [{h.collection_id}] Book {h.book_number}, Hadith {h.hadith_number}\")\n",
    "        print(f\"    Grade: {h.grade} ({h.grade_source})\")\n",
    "        print(f\"    Text: {h.text_original[:120]}...\")\n",
    "        print()\n",
    "except Exception as e:\n",
    "    print(f\"Hadith by topic: {e}\")\n",
    "\n",
    "# Search hadith text\n",
    "try:\n",
    "    results = quran.hadith.search(\"إسلام\", limit=3)\n",
    "    print(f\"Hadith search for 'إسلام': {len(results)} results\")\n",
    "    for r in results:\n",
    "        print(f\"  [{r.collection_id}] {r.text_original[:100]}...\")\n",
    "except Exception as e:\n",
    "    print(f\"Hadith search: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Extension Adapters - Qira'at (Variant Readings)\n",
    "\n",
    "Compare different canonical readings (Hafs, Warsh, Qalun, etc.)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compare readings for Ayah 1:1\n",
    "try:\n",
    "    readings = quran.qiraat.get_readings(1, 1)\n",
    "    print(f\"Qira'at for 1:1: {len(readings)} readings\")\n",
    "    for r in readings:\n",
    "        diffs = r.differences\n",
    "        diff_str = f\" ({len(diffs)} differences)\" if diffs else \" (same)\"\n",
    "        print(f\"  [{r.qiraat_id}] {r.text_original}{diff_str}\")\n",
    "        if diffs:\n",
    "            for d in diffs:\n",
    "                print(f\"    - {d['type']}: {d['detail']}\")\n",
    "except Exception as e:\n",
    "    print(f\"Qira'at: {e}\")\n",
    "\n",
    "# Compare 2:255 (Ayat al-Kursi) across readings\n",
    "try:\n",
    "    readings = quran.qiraat.get_readings(2, 255)\n",
    "    print(f\"\\nQira'at for 2:255: {len(readings)} readings\")\n",
    "    for r in readings:\n",
    "        print(f\"  [{r.qiraat_id}] {r.text_original[:80]}...\")\n",
    "except Exception as e:\n",
    "    print(f\"Qira'at 2:255: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Extension Adapters - Tajwid Rules\n",
    "\n",
    "Access tajwid (recitation rules) with examples from the Qur'an."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Get all tajwid rules\n",
    "try:\n",
    "    rules = quran.tajwid.get_all_rules()\n",
    "    print(f\"Total tajwid rules: {len(rules)}\")\n",
    "    \n",
    "    # Group by type\n",
    "    by_type = {}\n",
    "    for r in rules:\n",
    "        by_type.setdefault(r.rule_type, []).append(r)\n",
    "    \n",
    "    for rtype, rlist in by_type.items():\n",
    "        print(f\"\\n  {rtype}: {len(rlist)} rules\")\n",
    "        for r in rlist[:2]:\n",
    "            print(f\"    - {r.rule_id}: {r.name}\")\n",
    "except Exception as e:\n",
    "    print(f\"Tajwid rules: {e}\")\n",
    "\n",
    "# Get tajwid rules for specific ayah\n",
    "try:\n",
    "    rules = quran.tajwid.get_rules_for_ayah(1, 1)\n",
    "    print(f\"\\nTajwid rules for 1:1: {len(rules)}\")\n",
    "    for r in rules:\n",
    "        print(f\"  - {r.name} ({r.rule_type}): {r.description[:80]}...\")\n",
    "except Exception as e:\n",
    "    print(f\"Tajwid for ayah: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Extension Adapters - Waqf (Stopping Signs)\n",
    "\n",
    "Access waqf (stopping/continuing) rules for proper recitation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Get waqf signs for Surah Al-Fatiha\n",
    "try:\n",
    "    signs = quran.waqf.get_signs_for_surah(1)\n",
    "    print(f\"Waqf signs for Surah 1: {len(signs)}\")\n",
    "    \n",
    "    # Group by type\n",
    "    by_type = {}\n",
    "    for s in signs:\n",
    "        by_type.setdefault(s.rule_type, []).append(s)\n",
    "    \n",
    "    for stype, slist in by_type.items():\n",
    "        print(f\"\\n  {stype}: {len(slist)} signs\")\n",
    "        for s in slist[:3]:\n",
    "            pos = f\"word {s.word_position}\" if s.word_position > 0 else \"end\"\n",
    "            print(f\"    {s.ayah_number}:{pos} - {s.name} ({s.sign_character or 'none'})\")\n",
    "except Exception as e:\n",
    "    print(f\"Waqf for surah: {e}\")\n",
    "\n",
    "# Get waqf for specific ayah\n",
    "try:\n",
    "    signs = quran.waqf.get_signs_for_ayah(1, 1)\n",
    "    print(f\"\\nWaqf signs for 1:1: {len(signs)}\")\n",
    "    for s in signs:\n",
    "        print(f\"  {s.name}: {s.description} [{s.sign_character}]\")\n",
    "except Exception as e:\n",
    "    print(f\"Waqf for ayah: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Computational Research\n",
    "\n",
    "Perform statistical analysis on Qur'anic text."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from qurankit.research import CrossReferenceEngine\n",
    "\n",
    "# Cross-reference engine\n",
    "engine = CrossReferenceEngine()\n",
    "\n",
    "# Find cross-references for a phrase\n",
    "try:\n",
    "    refs = engine.find_cross_references(\"بسم الله الرحمن الرحيم\")\n",
    "    print(f\"Cross-references for Basmalah: {len(refs)} references\")\n",
    "    for r in refs[:5]:\n",
    "        print(f\"  {r.reference}: {r.matched_text[:60]}\")\n",
    "except Exception as e:\n",
    "    print(f\"Cross-references: {e}\")\n",
    "\n",
    "# Wujuh wa Nazair (Faces and Counterparts)\n",
    "try:\n",
    "    wn = engine.wujuh_wa_nazair(\"2:255\", max_results=5)\n",
    "    print(f\"\\nWujuh wa Nazair for 2:255: {len(wn)} pairs\")\n",
    "    for pair in wn[:3]:\n",
    "        print(f\"  {pair.reference}: {pair.matched_text[:60]} (score: {pair.similarity:.2f})\")\n",
    "except Exception as e:\n",
    "    print(f\"Wujuh wa Nazair: {e}\")"
   ]
  },
